# Copie este arquivo para .env e preencha somente no seu computador.
# Nunca coloque valores reais neste arquivo versionado.
GOOGLE_API_KEY=

# Opcional: reserva operacional do LLM. Sem esta chave, somente o Gemini é usado.
GROQ_API_KEY=

# Necessária para embeddings, recuperação vetorial e reranking do RAG NVIDIA.
NVIDIA_API_KEY=
